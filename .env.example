# Rent-A-Bot configuration. Copy to .env (repo root) or server/.env; real environment variables win.
# Never commit real values.

# ---------- server ----------
PORT=8790
HOST=0.0.0.0
# Public base URL: PayPal return/cancel URLs, artifact links and claim links are built from it.
PUBLIC_URL=http://localhost:8790
# SQLite database, artifacts, seal.key and demo-keys.json live here (relative to the repo root).
DATA_DIR=data
# Demo mode: seeds demo personas and house bots, enables demo reset.
DEMO_MODE=1
# Timers (contract windows, mediator answer windows) run this many times faster in demo mode: 60 = 1 h in 1 min.
DEMO_TIME_SCALE=1
# Scheduler tick in ms (timers, reauthorization, payout retries).
TICK_MS=3000
LOG_LEVEL=info
CORS_ORIGINS=
WEB_DIST=
ALLOW_HOSTS=

# ---------- PayPal ----------
# With client id + secret the PayPal REST rail is used (sandbox unless PAYPAL_ENV=live);
# without them the clearly labelled "simulated" rail runs offline.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal app's webhook settings; needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# Optional egress proxy for hosts that cannot reach PayPal directly (no IPv4): a Cloudflare Worker, see
# deploy/cloudflare/paypal-egress. Empty = the official PayPal URL for PAYPAL_ENV.
PAYPAL_API_BASE=
PAYPAL_EGRESS_SECRET=
# Optional page-fetch egress for IPv6-only hosts: house bots and url/page checks fetch IPv4-only sites through this
# Cloudflare Worker (deploy/cloudflare/web-egress). Empty = always fetch directly.
WEB_EGRESS_URL=
WEB_EGRESS_SECRET=

# Optional: the Lead Verifier's own Hunter.io account (free plan: 50 domain searches a month). With a key the bot also
# offers find_leads (sent as the X-API-KEY header, never logged or shown); without it the skill is not listed.
HUNTER_API_KEY=

# ---------- Log in with PayPal (people sign up / sign in; docs/API.md "Accounts") ----------
# On by default when a client id + secret exist (PAYPAL_LOGIN_CLIENT_* or else PAYPAL_CLIENT_*). PAYPAL_LOGIN=off hides it.
# Enable "Log in with PayPal" on the REST app and add the return URL ${PUBLIC_URL}/api/auth/paypal/callback.
PAYPAL_LOGIN=on
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
# Defaults: PAYPAL_ENV; https://www.sandbox.paypal.com/connect (live www.paypal.com); PAYPAL_API_BASE (egress) else api-m.
PAYPAL_LOGIN_ENV=
PAYPAL_LOGIN_AUTHORIZE_URL=
PAYPAL_LOGIN_API_BASE=
# Default "openid profile email https://uri.paypal.com/services/paypalattributes" (the last gives payer id + verified flag;
# tick those attributes in the app's Log in with PayPal settings, or drop the scope).
PAYPAL_LOGIN_SCOPES=
# Default ${PUBLIC_URL}/api/auth/paypal/callback. Must match the return URL saved on the PayPal app exactly.
PAYPAL_LOGIN_REDIRECT_URI=
# HMAC key for the OAuth state parameter. Empty = random per process.
SESSION_SECRET=

# ---------- fees (docs/ESCROW_PAYPAL.md "Platform economics") ----------
# commission = max(PLATFORM_FEE_FLOOR, PLATFORM_COMMISSION_PCT x captured), half-up to the cent.
PLATFORM_COMMISSION_PCT=0.15
PLATFORM_FEE_FLOOR=3.00
# Interim settlements below this wait for more verified units or the job end.
MIN_SETTLEMENT=5.00
# Charged only when a dispute ends in a ruling (split by fault); a settlement by agreement is free.
MEDIATION_FLAT=1.00
APPEAL_BOND=5.00
# How long each mediation round (of 3) stays open for answers (ISO duration; divided by DEMO_TIME_SCALE in demo mode).
MEDIATION_ROUND=PT2H
# Shortest real time (ms) an open job takes bids, however fast DEMO_TIME_SCALE runs, so outside agents can bid. 0 = off.
BID_WINDOW_FLOOR_MS=300000
# Webhook fallback: a capture or payout still unconfirmed after this many seconds is looked up on PayPal (scaled in demo mode).
RECONCILE_AFTER_SECONDS=60
# Estimated PayPal costs for previews and P&L (actual fees are recorded from PayPal responses).
PAYPAL_CAPTURE_PCT=0.0349
PAYPAL_CAPTURE_FIXED=0.49
PAYPAL_PAYOUT_FEE=0.25

# ---------- secrets ----------
# 64 hex chars (or any passphrase, hashed to 32 bytes) for AES-256-GCM sealing of job secrets.
# Empty: one is generated and kept in DATA_DIR/seal.key.
SEAL_KEY=
# Payout email of the seeded "Glob Studio Bots" operator (a PayPal sandbox personal account).
SEED_PAYOUT_EMAIL=

# ---------- AI (read by server/src/intelligence) ----------
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
